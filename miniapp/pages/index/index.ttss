.page{padding:24rpx 24rpx 60rpx}.hero{background:#10272a;color:#fff;border-radius:24rpx;padding:28rpx;display:flex;align-items:center;gap:20rpx}.mark{width:76rpx;height:76rpx;background:#b8f447;color:#10272a;border-radius:18rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:900;transform:skew(-7deg)}.brand{font-size:36rpx;font-weight:900;letter-spacing:5rpx}.sub{font-size:20rpx;color:#91a5a7;margin-top:4rpx}.tabs{display:flex;background:#fff;margin:22rpx 0;border-radius:18rpx;padding:8rpx}.tab{flex:1;text-align:center;padding:20rpx;border-radius:14rpx;color:#748285;font-size:25rpx;font-weight:700}.tab.active{background:#b8f447;color:#10272a}.card{background:#fff;border:1rpx solid #e2e9e7;border-radius:22rpx;padding:28rpx;margin-bottom:20rpx}.section-title{display:flex;gap:18rpx;margin-bottom:25rpx}.section-title>text{color:#86bd25;border-top:4rpx solid #b8f447;padding-top:8rpx;font-size:20rpx;font-weight:800}.section-title b{display:block;font-size:30rpx}.section-title small{display:block;color:#899697;font-size:20rpx;margin-top:5rpx}.field{margin-bottom:22rpx}.field label{display:block;color:#526164;font-size:22rpx;font-weight:700;margin-bottom:10rpx}.field input,.field textarea,.picker{width:100%;box-sizing:border-box;border:1rpx solid #dce5e4;border-radius:14rpx;background:#fafcfc;padding:20rpx 18rpx;font-size:25rpx;min-height:76rpx}.field textarea{line-height:1.65}.date-row{display:flex;gap:12rpx}.date-row picker{flex:1}.calendar-title{text-align:center;font-size:28rpx;font-weight:800;margin-bottom:18rpx}.week,.days{display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx}.week text{text-align:center;color:#899697;font-size:20rpx}.day{height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:22rpx;border:3rpx solid transparent}.day.done{background:#b7db3f;color:#102225;font-weight:800}.day.next{border-color:#b7db3f}.day.miss{background:#ff2ca8;color:#fff;font-weight:800}.day.empty{visibility:hidden}.legend{display:flex;gap:18rpx;margin-top:20rpx;font-size:19rpx}.legend .done,.legend .next{color:#7fa61f}.legend .miss{color:#ff2ca8}.exercise{display:grid;grid-template-columns:2fr .5fr 20rpx .8fr 80rpx;gap:10rpx;align-items:center;padding:12rpx;background:#f5f8f7;border-radius:14rpx;margin-bottom:12rpx}.exercise input{background:#fff;border:1rpx solid #dce5e4;border-radius:10rpx;padding:14rpx;font-size:22rpx}.outline,.primary{border-radius:14rpx;font-weight:800;font-size:25rpx}.outline{background:#fff;border:2rpx solid #c8d6d3;color:#526b70}.primary{background:#10272a;color:#fff}.ability{border:1rpx solid #e2e9e7;border-radius:14rpx;padding:16rpx;margin-bottom:12rpx}.ability b{font-size:24rpx}.ability>view{display:grid;grid-template-columns:120rpx 1fr;align-items:center;color:#728083;font-size:19rpx}.ability slider{margin:0}.muscles{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.muscle{text-align:center;border:1rpx solid #dce5e4;border-radius:12rpx;padding:17rpx 8rpx;color:#647274;font-size:21rpx}.muscle.selected{background:#eff8d9;border-color:#9fca34;color:#26320d;font-weight:800}.actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:26rpx}.actions button,.save{padding:20rpx}.preview-wrap{background:#fff;border-radius:22rpx;padding:18rpx;overflow:hidden}.poster{display:block;width:100%!important;height:auto!important;aspect-ratio:9/16;background:#050505}.save{margin-top:20rpx;width:100%}.privacy{text-align:center;color:#98a4a5;font-size:19rpx;margin-top:18rpx}
